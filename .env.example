# KIE
KIE_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3

# Steady API（for reddit，for Shenzhen Expo Hunter， optional）
STEADY_API_KEY=

# X API（for Codex Reset Notifier）
# OAuth 1.0a consumer credentials. X_CONSUMER_* is accepted as an alias.
X_API_KEY=
X_API_SECRET=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# X OAuth 2.0 app credentials（for project-level full X MCP via xurl）
X_CLIENT_ID=
X_CLIENT_SECRET=

# Resend email（for Codex Reset Notifier）
RESEND_API_KEY=
RESEND_FROM="Codex Reset <onboarding@resend.dev>"
